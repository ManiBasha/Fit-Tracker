rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/checklist/{dateId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/metrics/{dateId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Soulmate groups: a member can only read a group's roster if they are
    // already a member of that same group (i.e. they know the shared code
    // and have joined). Anyone signed in can join by creating their own
    // member doc — that's the "join with a code" action.
    match /groups/{code}/members/{uid} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/groups/$(code)/members/$(request.auth.uid));
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
