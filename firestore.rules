rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/checklist/{dateId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
